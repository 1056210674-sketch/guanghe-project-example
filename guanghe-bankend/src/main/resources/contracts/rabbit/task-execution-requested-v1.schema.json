{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zhixiaohe.local/contracts/rabbit/task-execution-requested-v1.schema.json",
  "title": "TaskExecutionRequestedV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "eventId",
    "eventType",
    "taskId",
    "taskType",
    "userId",
    "spaceId",
    "attempt",
    "traceparent",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "eventId": { "$ref": "#/$defs/id" },
    "eventType": { "const": "TASK_EXECUTION_REQUESTED" },
    "taskId": { "$ref": "#/$defs/id" },
    "taskType": { "enum": ["GEO", "IMAGE", "VIDEO", "ARTICLE"] },
    "userId": { "$ref": "#/$defs/id" },
    "spaceId": { "$ref": "#/$defs/id" },
    "attempt": { "type": "integer", "minimum": 1 },
    "traceparent": {
      "type": "string",
      "pattern": "^[0-9a-f]{2}-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$"
    },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[1-9][0-9]*$" }
  }
}
