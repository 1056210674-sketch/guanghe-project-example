{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zhixiaohe.local/contracts/sse/conversation-event-v1.schema.json",
  "title": "ConversationEventV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "sequence", "eventType", "occurredAt", "conversationId", "messageId", "taskId", "payload"],
  "properties": {
    "eventId": { "$ref": "#/$defs/id" },
    "sequence": { "type": "integer", "minimum": 1 },
    "eventType": {
      "enum": [
        "message.start",
        "message.delta",
        "message.completed",
        "interaction.required",
        "context.resource",
        "agent.progress",
        "draft.created",
        "draft.expired",
        "task.queued",
        "task.progress",
        "task.completed",
        "task.failed",
        "notification.created",
        "heartbeat"
      ]
    },
    "occurredAt": { "type": "string", "format": "date-time" },
    "conversationId": { "$ref": "#/$defs/id" },
    "messageId": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
    "taskId": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
    "payload": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "eventType": { "const": "message.delta" } }, "required": ["eventType"] },
      "then": { "properties": { "payload": { "$ref": "#/$defs/messageDeltaPayload" } } }
    },
    {
      "if": { "properties": { "eventType": { "const": "context.resource" } }, "required": ["eventType"] },
      "then": { "properties": { "payload": { "$ref": "#/$defs/resourcePayload" } } }
    },
    {
      "if": { "properties": { "eventType": { "const": "message.completed" } }, "required": ["eventType"] },
      "then": { "properties": { "payload": { "$ref": "#/$defs/messageCompletedPayload" } } }
    },
    {
      "if": {
        "properties": { "eventType": { "const": "agent.progress" } },
        "required": ["eventType"]
      },
      "then": {
        "properties": { "payload": { "$ref": "#/$defs/agentProgressPayload" } }
      }
    },
    {
      "if": {
        "properties": {
          "eventType": {
            "enum": ["task.queued", "task.progress", "task.completed", "task.failed"]
          }
        },
        "required": ["eventType"]
      },
      "then": {
        "properties": {
          "messageId": { "type": "null" },
          "taskId": { "$ref": "#/$defs/id" },
          "payload": { "$ref": "#/$defs/backgroundTaskPayload" }
        }
      }
    }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "messageDeltaPayload": {
      "type": "object", "additionalProperties": false, "required": ["messageId", "delta"],
      "properties": {
        "messageId": { "$ref": "#/$defs/id" },
        "delta": { "type": "string", "maxLength": 16000 },
        "replace": { "type": "boolean", "default": false,
          "description": "Append unless true. True replaces the owning active Run's entire response text; empty delta clears it. Persisted and replayed by sequence." }
      },
      "allOf": [{
        "if": { "required": ["replace"], "properties": { "replace": { "const": true } } },
        "else": { "properties": { "delta": { "minLength": 1 } } }
      }]
    },
    "resourcePayload": {
      "type": "object", "additionalProperties": false, "required": ["kind", "success", "runId"],
      "properties": {
        "kind": { "enum": ["SEARCH", "READ"] },
        "success": { "type": "boolean" },
        "runId": { "type": "string", "format": "uuid" },
        "errorCode": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,127}$" },
        "status": { "enum": ["UNIQUE", "MULTIPLE", "NOT_FOUND", "INCOMPLETE"] },
        "purpose": { "enum": ["CATALOG_SUMMARY", "LATEST_GEO_REPORT", "GEO_ANSWER_EVIDENCE", "GEO_DIAGNOSTIC_REPORT", "ASSET_INVENTORY"] },
        "candidateSetId": { "$ref": "#/$defs/id" },
        "choiceId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "observationId": { "$ref": "#/$defs/id" },
        "resourceId": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "maxLength": 200 },
        "reportId": { "$ref": "#/$defs/id" },
        "spaceId": { "$ref": "#/$defs/id" },
        "productId": { "$ref": "#/$defs/id" }
      }
    },
    "businessOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "status"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "status": { "enum": ["ANSWERED", "NEEDS_INPUT", "DRAFT_READY", "PARTIAL", "FAILED"] },
        "reasonCode": {
          "enum": ["INPUT_REQUIRED", "TASK_DRAFT_PROPOSED", "READONLY_PLANNER_UNAVAILABLE", "READONLY_PLAN_INVALID",
                   "READONLY_EVIDENCE_UNAVAILABLE", "READONLY_PARTIAL_EVIDENCE", "READONLY_SYNTHESIS_UNAVAILABLE", "GEO_CONTEXT_UNAVAILABLE",
                   "TASK_PARAMETERS_INVALID", "TASK_PREPARATION_REJECTED", "RESPONSE_PROTOCOL_INVALID", "AGENT_RUN_FAILED"]
        },
        "failureStage": { "enum": ["LOOKUP", "PLAN", "TOOL", "SYNTHESIS", "PROTOCOL"] }
      }
    },
    "messageCompletedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["messageId", "runId", "status"],
      "properties": {
        "messageId": { "$ref": "#/$defs/id" },
        "runId": { "type": "string", "format": "uuid" },
        "status": { "enum": ["COMPLETED", "FAILED", "STOPPED"] },
        "businessOutcome": { "$ref": "#/$defs/businessOutcome" },
        "articlePreparation": {
          "type": "object", "additionalProperties": false, "required": ["preparationId", "articleId"],
          "properties": { "preparationId": { "$ref": "#/$defs/id" }, "articleId": { "$ref": "#/$defs/id" } }
        }
      }
    },
    "agentProgressPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "messageId", "stageCode", "status", "ordinal", "elapsedMs", "current", "total"],
      "properties": {
        "runId": { "type": "string", "format": "uuid" },
        "messageId": { "$ref": "#/$defs/id" },
        "stageCode": {
          "enum": [
            "UNDERSTANDING_REQUEST",
            "LOADING_BUSINESS_CONTEXT",
            "LOADING_PRODUCT_CONTEXT",
            "LOADING_REFERENCE_ASSETS",
            "ROUTING_INTENT",
            "PLANNING_WORKFLOW",
            "RUNNING_SAFE_TOOL",
            "SEARCHING_WEB",
            "PREPARING_TASK_DRAFT",
            "COMPOSING_RESPONSE"
          ]
        },
        "status": { "enum": ["RUNNING", "SUCCEEDED", "FAILED"] },
        "ordinal": { "type": "integer", "minimum": 1, "maximum": 32 },
        "elapsedMs": { "type": "integer", "minimum": 0 },
        "current": { "type": ["integer", "null"], "minimum": 0 },
        "total": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "backgroundTaskPayload": {
      "type": "object",
      "additionalProperties": true,
      "required": ["taskId", "deliveryKind", "status"],
      "properties": {
        "taskId": { "$ref": "#/$defs/id" },
        "deliveryKind": { "const": "BACKGROUND_TASK" },
        "status": {
          "enum": ["QUEUED", "RUNNING", "RETRY_WAIT", "SUCCEEDED", "PARTIAL", "FAILED", "SKIPPED", "SYSTEM_TERMINATED"]
        },
        "stageCode": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$" },
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$" },
        "resultRef": { "type": "string", "pattern": "^(task|asset|geo-report|article):[1-9][0-9]{0,18}$" },
        "articlePreview": {
          "description": "A genuine BODY preview changed; read the owner-scoped preparation preview endpoint to recover current content. Not a completed result.",
          "type": "object", "additionalProperties": false,
          "required": ["preparationId", "articleId", "executionNo", "attempt", "sequence"],
          "properties": {
            "preparationId": { "$ref": "#/$defs/id" }, "articleId": { "$ref": "#/$defs/id" },
            "executionNo": { "type": "integer", "minimum": 1 },
            "attempt": { "type": "integer", "minimum": 1, "maximum": 10 },
            "sequence": { "type": "integer", "minimum": 1, "maximum": 10000 }
          }
        }
      }
    }
  }
}
