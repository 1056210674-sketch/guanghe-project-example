# Local-only example. Never commit real credentials.
GUANGHE_AGENT_ENVIRONMENT=<environment>
GUANGHE_AGENT_LOG_LEVEL=<log-level>
GUANGHE_AGENT_OTEL_ENABLED=<true-or-false>
GUANGHE_AGENT_OTEL_OTLP_ENDPOINT=<collector-http-protobuf-v1-traces-endpoint>
GUANGHE_AGENT_OTEL_METRICS_ENABLED=<true-or-false>
GUANGHE_AGENT_OTEL_METRICS_OTLP_ENDPOINT=<collector-http-protobuf-v1-metrics-endpoint>
GUANGHE_AGENT_OTEL_METRICS_EXPORT_INTERVAL_MS=<bounded-export-interval-ms>
GUANGHE_AGENT_OTEL_OTLP_PROTOCOL=http/protobuf
GUANGHE_AGENT_OTEL_SAMPLE_RATIO=<0.0-to-1.0>
GUANGHE_AGENT_OTEL_EXPORT_TIMEOUT_SECONDS=<export-timeout-seconds>
GUANGHE_AGENT_OTEL_BATCH_MAX_QUEUE_SIZE=<bounded-export-queue-size>
GUANGHE_AGENT_OTEL_BATCH_MAX_EXPORT_BATCH_SIZE=<bounded-export-batch-size>
GUANGHE_AGENT_OTEL_BATCH_SCHEDULE_DELAY_MS=<batch-schedule-delay-ms>
GUANGHE_AGENT_LANGFUSE_EXPORT_ENABLED=<true-or-false>
GUANGHE_AGENT_LANGFUSE_EXPORT_COLLECTOR_CONFIGURED=<true-or-false>
GUANGHE_AGENT_BIND_HOST=<loopback-bind-host>
GUANGHE_AGENT_BIND_PORT=<api-port>
GUANGHE_AGENT_WORKER_BIND_HOST=<loopback-worker-bind-host>
GUANGHE_AGENT_WORKER_BIND_PORT=<worker-port>
GUANGHE_AGENT_WORKER_ID=<worker-id>
GUANGHE_AGENT_WORKER_CONSUMER_NAME=<worker-consumer-name>
GUANGHE_AGENT_WORKER_TASK_TYPE=<worker-task-type>
GUANGHE_AGENT_WORKER_BROKER=<LOCAL-or-RABBITMQ>
GUANGHE_AGENT_WORKER_CONTROL_PLANE=<worker-control-plane>
GUANGHE_AGENT_WORKER_PROVIDER=MOCK
GUANGHE_AGENT_WORKER_MAX_CONCURRENCY=<worker-max-concurrency>
GUANGHE_AGENT_WORKER_GRACEFUL_TIMEOUT_SECONDS=<worker-graceful-timeout-seconds>
GUANGHE_AGENT_WORKER_PROVIDER_MAX_ATTEMPTS=<worker-provider-max-attempts>
GUANGHE_AGENT_WORKER_PROVIDER_RETRY_BASE_SECONDS=<worker-retry-base-seconds>
GUANGHE_AGENT_WORKER_PROVIDER_RETRY_MAX_SECONDS=<worker-retry-max-seconds>
GUANGHE_AGENT_WORKER_PROVIDER_RETRY_BUDGET_SECONDS=<worker-retry-budget-seconds>
GUANGHE_AGENT_ENABLE_DEV_CONSOLE=<true-or-false>
GUANGHE_AGENT_MOCK_EVENT_DELAY_MS=<mock-event-delay-ms>
GUANGHE_AGENT_MODEL_GATEWAY=<model-gateway-mode>
GUANGHE_AGENT_BUSINESS_OUTCOME_ENABLED=false
GUANGHE_AGENT_RESOURCE_LOOKUP_ENABLED=false
GUANGHE_AGENT_INTENT_ROUTER_MODE=<DEEPSEEK_PRIMARY-or-QWEN_SHADOW-or-QWEN_PRIMARY>
GUANGHE_AGENT_INTENT_ROUTER_SHADOW_TIMEOUT_SECONDS=<bounded-shadow-timeout-seconds>
GUANGHE_AGENT_RUN_CONTEXT_PROVIDER=<run-context-provider-mode>
GUANGHE_AGENT_GIT_COMMIT=<full-git-commit>

# Internal M1 communication. Replace placeholders only in the server-owned env file.
GUANGHE_AGENT_JAVA_INTERNAL_BASE_URL=<loopback-java-internal-base-url>
GUANGHE_AGENT_WORKFLOW_PLAN_MAX_POINT_COST=<positive-point-cap>
GUANGHE_AGENT_WORKFLOW_PLAN_DEADLINE_SECONDS=<120-to-2592000>
GUANGHE_AGENT_INTERNAL_HMAC_KEY_ID=<shared-internal-key-id>
GUANGHE_AGENT_INTERNAL_HMAC_SECRET=<shared-internal-hmac-secret>
GUANGHE_AGENT_INTERNAL_HMAC_ALLOWED_CLOCK_SKEW_SECONDS=<allowed-clock-skew-seconds>
GUANGHE_AGENT_INTERNAL_HMAC_NONCE_TTL_SECONDS=<nonce-ttl-seconds>
GUANGHE_AGENT_INTERNAL_HMAC_MAX_BODY_BYTES=<maximum-signed-body-bytes>
GUANGHE_AGENT_REDIS_HOST=<test-redis-host>
GUANGHE_AGENT_REDIS_PORT=<test-redis-port>
GUANGHE_AGENT_REDIS_USERNAME=<test-redis-username-or-empty>
GUANGHE_AGENT_REDIS_PASSWORD=<test-redis-password>
GUANGHE_AGENT_REDIS_SSL_ENABLED=<true-or-false>
GUANGHE_AGENT_REDIS_CA_CERT_PATH=<absolute-ca-certificate-path-or-empty>
GUANGHE_AGENT_REDIS_KEY_PREFIX=<zhixiaohe-test-key-prefix>

# Rabbit credentials belong only in the server-owned environment file. IMAGE,
# VIDEO, GEO, ARTICLE, and WORKFLOW queues must already exist; each Python Worker consumes only its known queue
# passively and does not declare topology.
GUANGHE_AGENT_RABBITMQ_URL=
GUANGHE_AGENT_RABBITMQ_QUEUE_NAME=<zhixiaohe.agent.image-or-video-or-geo-or-article-or-workflow>
GUANGHE_AGENT_RABBITMQ_ROUTING_KEY=<agent.image-or-video-or-geo-or-article-or-workflow>
GUANGHE_AGENT_RABBITMQ_PREFETCH_COUNT=<rabbitmq-prefetch-count>
GUANGHE_AGENT_RABBITMQ_CONNECTION_TIMEOUT_SECONDS=<rabbitmq-connection-timeout-seconds>

# Providers remain explicitly unavailable until both credential and model are set.
# These placeholders are not evidence that any real Provider Gate has passed.
GUANGHE_AGENT_DEEPSEEK__CREDENTIAL=
GUANGHE_AGENT_DEEPSEEK__MODEL=<deepseek-model-after-provider-gate>
GUANGHE_AGENT_DEEPSEEK__ENDPOINT=<deepseek-endpoint-after-provider-gate>
GUANGHE_AGENT_DEEPSEEK__TIMEOUT_SECONDS=<deepseek-timeout-seconds>
GUANGHE_AGENT_DEEPSEEK__PROBE_TIMEOUT_SECONDS=<deepseek-probe-timeout-seconds>
GUANGHE_AGENT_DEEPSEEK__MAX_RETRIES=<deepseek-max-retries>
GUANGHE_AGENT_DEEPSEEK__TRUST_ENV=<true-or-false>
GUANGHE_AGENT_QWEN__CREDENTIAL=
GUANGHE_AGENT_QWEN__MODEL=<qwen-model-after-provider-gate>
GUANGHE_AGENT_QWEN__ENDPOINT=<qwen-endpoint-after-provider-gate>
GUANGHE_AGENT_QWEN__TIMEOUT_SECONDS=<qwen-timeout-seconds>
GUANGHE_AGENT_QWEN__PROBE_TIMEOUT_SECONDS=<qwen-probe-timeout-seconds>
GUANGHE_AGENT_QWEN__MAX_RETRIES=<qwen-max-retries>
GUANGHE_AGENT_QWEN__TRUST_ENV=<true-or-false>

# Dedicated Bailian intent-router configuration. It is disabled unless both
# credential and model are explicitly configured; never reuse a media Provider key.
GUANGHE_AGENT_INTENT_ROUTER_QWEN__CREDENTIAL=
GUANGHE_AGENT_INTENT_ROUTER_QWEN__MODEL=<trained-bailian-router-model>
GUANGHE_AGENT_INTENT_ROUTER_QWEN__ENDPOINT=<bailian-openai-compatible-endpoint>
GUANGHE_AGENT_INTENT_ROUTER_QWEN__TIMEOUT_SECONDS=<router-timeout-seconds>
GUANGHE_AGENT_INTENT_ROUTER_QWEN__PROBE_TIMEOUT_SECONDS=<router-probe-timeout-seconds>
GUANGHE_AGENT_INTENT_ROUTER_QWEN__MAX_RETRIES=<bounded-http-retries>
GUANGHE_AGENT_INTENT_ROUTER_QWEN__TRUST_ENV=<true-or-false>

# EXPERIMENTAL, not part of M5 and pending the Volcano-vs-DashScope decision.
# Real IMAGE/VIDEO generation may incur charges. Keep WORKER_PROVIDER=MOCK by default.
GUANGHE_AGENT_QWEN_IMAGE__CREDENTIAL=
GUANGHE_AGENT_WAN_IMAGE_EDIT__ENABLED=false
GUANGHE_AGENT_WAN_IMAGE_EDIT__CREDENTIAL=
GUANGHE_AGENT_WAN_IMAGE_EDIT__MODEL=wanx2.1-imageedit
GUANGHE_AGENT_WAN_IMAGE_EDIT__ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/aigc/image2image/image-synthesis
GUANGHE_AGENT_QWEN_IMAGE__MODEL=<experimental-qwen-image-model>
GUANGHE_AGENT_QWEN_IMAGE__ENDPOINT=<experimental-qwen-image-endpoint>
GUANGHE_AGENT_QWEN_IMAGE__TIMEOUT_SECONDS=<experimental-qwen-image-timeout-seconds>
GUANGHE_AGENT_QWEN_IMAGE__PROBE_TIMEOUT_SECONDS=<experimental-qwen-image-probe-timeout-seconds>
GUANGHE_AGENT_QWEN_IMAGE__MAX_RETRIES=<experimental-qwen-image-max-retries>
GUANGHE_AGENT_QWEN_IMAGE__TRUST_ENV=<true-or-false>
GUANGHE_AGENT_WAN_VIDEO__CREDENTIAL=
GUANGHE_AGENT_WAN_VIDEO__MODEL=<experimental-wan-video-model-after-provider-gate>
GUANGHE_AGENT_WAN_VIDEO__ENDPOINT=<experimental-wan-video-endpoint-after-provider-gate>
GUANGHE_AGENT_WAN_VIDEO__TIMEOUT_SECONDS=<experimental-wan-video-timeout-seconds>
GUANGHE_AGENT_WAN_VIDEO__PROBE_TIMEOUT_SECONDS=<experimental-wan-video-probe-timeout-seconds>
GUANGHE_AGENT_WAN_VIDEO__MAX_RETRIES=<experimental-wan-video-max-retries>
GUANGHE_AGENT_WAN_VIDEO__TRUST_ENV=<true-or-false>

# GEO one-shot Provider Gate. Credentials stay empty in Git. Qwen accepts the
# official Beijing general Chat Completions endpoint or a Beijing Workspace host.
GUANGHE_AGENT_GEO_DOUBAO__CREDENTIAL=
GUANGHE_AGENT_GEO_DOUBAO__MODEL=<verified-doubao-web-search-model>
GUANGHE_AGENT_GEO_DOUBAO__ENDPOINT=<official-beijing-ark-responses-endpoint>
# GEO-only policy. Explicit existing TIMEOUT_SECONDS overrides remain effective.
GUANGHE_AGENT_GEO_DOUBAO__TIMEOUT_SECONDS=120
GUANGHE_AGENT_GEO_DOUBAO_POLICY__CONNECT_TIMEOUT_SECONDS=5
GUANGHE_AGENT_GEO_DOUBAO_POLICY__POOL_TIMEOUT_SECONDS=5
GUANGHE_AGENT_GEO_DOUBAO_POLICY__WRITE_TIMEOUT_SECONDS=10
GUANGHE_AGENT_GEO_DOUBAO_POLICY__REQUEST_TIMEOUT_SECONDS=150
# Per worker process, NOT an account-wide quota shared with other workers/old GEO.
GUANGHE_AGENT_GEO_DOUBAO_POLICY__MAX_CONCURRENCY=2
GUANGHE_AGENT_GEO_DOUBAO_POLICY__RETRY_BASE_SECONDS=15
GUANGHE_AGENT_GEO_DOUBAO_POLICY__RETRY_MAX_SECONDS=30
GUANGHE_AGENT_GEO_DOUBAO_POLICY__MAX_RETRY_WAIT_SECONDS=120
# Bocha remains available to native research/diagnostic preparation, but DeepSeek GEO monitoring
# does not use it. DeepSeek official Search and Chat reuse the credential below.
GUANGHE_AGENT_GEO_BOCHA__CREDENTIAL=
GUANGHE_AGENT_GEO_BOCHA__ENDPOINT=<official-bocha-web-search-endpoint>
GUANGHE_AGENT_GEO_DEEPSEEK__CREDENTIAL=
GUANGHE_AGENT_GEO_DEEPSEEK__MODEL=<configured-deepseek-model>
GUANGHE_AGENT_GEO_DEEPSEEK__ENDPOINT=<official-deepseek-endpoint>
GUANGHE_AGENT_GEO_QWEN__CREDENTIAL=
GUANGHE_AGENT_GEO_QWEN__MODEL=<verified-qwen-web-search-model>
GUANGHE_AGENT_GEO_QWEN__ENDPOINT=<official-beijing-chat-completions-endpoint>
GUANGHE_AGENT_GEO_WENXIN__CREDENTIAL=
GUANGHE_AGENT_GEO_WENXIN__MODEL=<verified-wenxin-search-model>
GUANGHE_AGENT_GEO_WENXIN__ENDPOINT=<official-qianfan-ai-search-endpoint>
GUANGHE_AGENT_GEO_KIMI__CREDENTIAL=
GUANGHE_AGENT_GEO_KIMI__MODEL=<verified-kimi-web-search-model>
# Kimi Search Pro and Chat use the same configured region: api.moonshot.cn for China
# accounts, api.moonshot.ai for international accounts. Their API Keys are not interchangeable.
GUANGHE_AGENT_GEO_KIMI__ENDPOINT=<official-kimi-chat-endpoint>
GUANGHE_AGENT_GEO_YUANBAO__CREDENTIAL=
GUANGHE_AGENT_GEO_YUANBAO__MODEL=<verified-tokenhub-web-search-model>
GUANGHE_AGENT_GEO_YUANBAO__ENDPOINT=<official-tokenhub-chat-endpoint>
GUANGHE_AGENT_GEO_TENCENT_SEARCH__CREDENTIAL=
GUANGHE_AGENT_GEO_TENCENT_SEARCH__ENDPOINT=https://api.wsa.cloud.tencent.com/SearchPro
GUANGHE_AGENT_GEO_TENCENT_SEARCH__MAX_RETRIES=0
GUANGHE_AGENT_GEO_ZHIPU__CREDENTIAL=
GUANGHE_AGENT_GEO_ZHIPU__MODEL=<verified-zhipu-web-search-model>
GUANGHE_AGENT_GEO_ZHIPU__ENDPOINT=<official-zhipu-chat-endpoint>

# Formal media placeholders remain reserved until the architecture owner freezes M5.
GUANGHE_AGENT_VOLCANO_IMAGE__CREDENTIAL=<volcano-image-credential>
GUANGHE_AGENT_VOLCANO_IMAGE__MODEL=<volcano-image-model>
GUANGHE_AGENT_VOLCANO_VIDEO__CREDENTIAL=<volcano-video-credential>
GUANGHE_AGENT_VOLCANO_VIDEO__MODEL=<volcano-video-model>

# Worker Provider Mock is local/test only and never becomes a production fallback.
GUANGHE_AGENT_PROVIDER_MOCK__ENABLED=<true-or-false>
GUANGHE_AGENT_PROVIDER_MOCK__LATENCY_MS=<mock-latency-ms>
GUANGHE_AGENT_PROVIDER_MOCK__FAILURE_MODE=<mock-failure-mode>
GUANGHE_AGENT_PROVIDER_MOCK__ARTIFACT_TTL_SECONDS=<mock-artifact-ttl-seconds>
